{
  "name": "invoiceflow",
  "version": "1.0.0",
  "description": "InvoiceFlow - invoicing, orders, quotes, statements and reports",
  "author": "Sign Girls",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "za.co.signgirls.invoiceflow",
    "productName": "InvoiceFlow",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "www/**/*", "package.json"],
    "win": { "icon": "build/icon.ico", "target": ["portable", "nsis"] },
    "portable": { "artifactName": "InvoiceFlow-Portable.exe" },
    "nsis": {
      "artifactName": "InvoiceFlow-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "InvoiceFlow"
    }
  }
}
